{
  "expo": {
    "name": "SmartKid Tutor",
    "slug": "smartkid-tutor",
    "scheme": "smartkidtutor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.smartkidtutor.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow SmartKid Tutor to access your camera so you can take a profile picture.",
        "NSPhotoLibraryUsageDescription": "Allow SmartKid Tutor to access your photos so you can choose a profile picture.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "smartkidtutor",
              "ng.smartkidtutor.app",
              "com.googleusercontent.apps.87739056632-7bb9jtr7u0ff6bm49tt6as340litfvms"
            ]
          }
        ]
      },
      "buildNumber": "9"
    },
    "android": {
      "package": "ng.smartkidtutor.app",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/0d1b447c-42af-4bb9-83b0-537687cb07b7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SmartKid Tutor to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow SmartKid Tutor to access your camera so you can take a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SmartKid Tutor to use your microphone so your child can talk to Ada."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-system-ui",
      "./plugins/withDisableLint.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.87739056632-7bb9jtr7u0ff6bm49tt6as340litfvms"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0d1b447c-42af-4bb9-83b0-537687cb07b7"
      }
    },
    "owner": "charlestechy0"
  }
}
